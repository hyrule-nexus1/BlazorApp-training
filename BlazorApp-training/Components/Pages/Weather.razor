@page "/weather"
@attribute [StreamRendering]
@inject HttpClient Http

<PageTitle>Live Breach Feed</PageTitle>

<h1>⚠ Live Threat Intelligence</h1>
<p>Latest cybersecurity incidents and data breaches from the web.</p>

@if (stories == null)
{
    <p><em>[ SCANNING DARKWEB... ]</em></p>
}
else
{
    <table class="table breach-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Incident</th>
                <th>Score</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var story in stories)
            {
                <tr>
                    <td>@story.Index</td>
                    <td>
                        @if (!string.IsNullOrEmpty(story.Url))
                        {
                            <a href="@story.Url" target="_blank">@story.Title</a>
                        }
                        else
                        {
                            @story.Title
                        }
                    </td>
                    <td>@story.Score</td>
                    <td>@(string.IsNullOrEmpty(story.Url) ? "HN" : new Uri(story.Url).Host)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<HNStory>? stories;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var searchUrl = "https://hn.algolia.com/api/v1/search?query=data+breach+hack+security&tags=story&hitsPerPage=20";
            var result = await Http.GetFromJsonAsync<HNSearchResult>(searchUrl);

            // Verifica cada URL antes de mostrarla
            var validStories = new List<HNStory>();
            int index = 1;

            foreach (var h in result?.Hits ?? [])
            {
                if (!string.IsNullOrEmpty(h.Url))
                {
                    try
                    {
                        var response = await Http.SendAsync(
                            new HttpRequestMessage(HttpMethod.Head, h.Url)
                        );

                        if (!response.IsSuccessStatusCode) continue; // ← salta 404s
                    }
                    catch
                    {
                        continue; // ← salta URLs que no responden
                    }
                }

                validStories.Add(new HNStory
                {
                    Index = index++,
                    Title = h.Title ?? "Unknown",
                    Url = h.Url ?? "",
                    Score = h.Points
                });
            }

            stories = validStories;
        }
            catch
            {
                stories = new List<HNStory>
            {
                new HNStory { Index = 1, Title = "[ ERROR: Connection to darkweb lost ]", Score = 0 }
            };
          }
    }

    private class HNSearchResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("hits")]
        public List<HNHit>? Hits { get; set; }
    }

    private class HNHit
    {
        [System.Text.Json.Serialization.JsonPropertyName("title")]
        public string? Title { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("url")]
        public string? Url { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("points")]
        public int Points { get; set; }
    }

    private class HNStory
    {
        public int Index { get; set; }
        public string Title { get; set; } = "";
        public string Url { get; set; } = "";
        public int Score { get; set; }
    }
}