@page "/counter"
@rendermode InteractiveServer
@using System.Timers

<PageTitle>Click Challenge</PageTitle>

<h1>Click Challenge</h1>

@if (!gameStarted && !gameOver)
{
    <div class="text-center mt-5">
        <h2>¿Puedes llegar a 100 clicks en 15 segundos?</h2>
        <button class="btn btn-success btn-lg mt-3" @onclick="StartGame">Iniciar</button>
    </div>
}
else if (gameStarted)
{
    <div class="text-center mt-3">
        <h2>Tiempo: <span class="@(timeLeft <= 3 ? "text-danger" : "text-success")">@timeLeft s</span></h2>
        <h3>Clicks: @currentCount / 100</h3>

        <div class="progress mb-3" style="height: 30px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="width: @(currentCount)%">
                @currentCount%
            </div>
        </div>

        <button class="btn btn-primary btn-lg" style="width: 200px; height: 200px; font-size: 3rem;"
                @onclick="IncrementCount">
            👊
        </button>
    </div>
}
else if (gameOver)
{
    <div class="text-center mt-5">
        @if (won)
        {
            <h1>¡GANASTE!</h1>
            <h3>Llegaste a 100 en @(10 - timeLeft) segundos!</h3>
            <p class="text-muted">Record: @recordCount clicks en una partida</p>
        }
        else
        {
            <h1>¡PERDISTE!</h1>
            <h3>Solo llegaste a @currentCount clicks...</h3>
            <p class="text-muted">¡Te faltaron @(100 - currentCount) clicks!</p>
        }
        <button class="btn btn-warning btn-lg mt-3" @onclick="ResetGame">Intentar de nuevo</button>
    </div>
}

@code {
    private int currentCount = 0;
    private int timeLeft = 15;
    private int recordCount = 0;
    private bool gameStarted = false;
    private bool gameOver = false;
    private bool won = false;
    private Timer? timer;

    private void StartGame()
    {
        currentCount = 0;
        timeLeft = 15;
        gameStarted = true;
        gameOver = false;
        won = false;

        timer = new Timer(1000);
        timer.Elapsed += OnTimerTick;
        timer.AutoReset = true;
        timer.Start();
    }

    private void IncrementCount()
    {
        if (!gameStarted) return;
        currentCount++;

        if (currentCount >= 100)
        {
            won = true;
            EndGame();
        }
    }

    private async void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        timeLeft--;

        if (timeLeft <= 0)
        {
            EndGame();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void EndGame()
    {
        timer?.Stop();
        timer?.Dispose();
        gameStarted = false;
        gameOver = true;

        if (currentCount > recordCount)
            recordCount = currentCount;
    }

    private void ResetGame()
    {
        gameOver = false;
        gameStarted = false;
        currentCount = 0;
        timeLeft = 10;
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}